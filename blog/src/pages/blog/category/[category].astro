---
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import Sidebar from "../../../components/Sidebar.astro";

const entries = await getCollection("gitbook");
const isContentPage = (id) => !/^(README|SUMMARY)\.md$/i.test(id);
const { category } = Astro.params;

const getTitle = (entry) => {
  if (entry.data?.title) {
    return entry.data.title;
  }

  const match = entry.body?.match(/^#\s+(.+)$/m);
  if (match) {
    return match[1].trim();
  }

  return entry.id;
};

const toLabel = (slug) =>
  slug
    .split("-")
    .map((part) => (part ? part[0].toUpperCase() + part.slice(1) : part))
    .join(" ");

const parseSummaryItems = (text) => {
  const items = [];
  const lines = text.split(/\r?\n/);

  for (const line of lines) {
    const match = line.match(/^\s*\*\s+\[([^\]]+)\]\(([^)\s]+)(?:\s+\"([^\"]+)\")?\)/);
    if (!match) {
      continue;
    }

    const label = match[1].trim();
    const href = match[2].trim();
    const titleAttr = match[3]?.trim();
    const menuLabel = titleAttr || label;
    if (/^https?:\/\//i.test(href)) {
      continue;
    }

    const slug = href.replace(/^\.\//, "").replace(/\.md$/i, "");
    items.push({ slug, title: menuLabel });
  }

  return items;
};

const buildSlugMap = (items) => {
  const counts = new Map();
  const map = new Map();

  for (const entry of items) {
    if (!isContentPage(entry.id)) {
      continue;
    }

    const base = entry.id.replace(/\.md$/, "").split("/").pop();
    const next = (counts.get(base) || 0) + 1;
    counts.set(base, next);
    const slug = next === 1 ? base : `${base}-${next}`;
    map.set(entry.id.replace(/\.md$/, ""), slug);
  }

  return map;
};

const entryMap = new Map(
  entries
    .filter((entry) => isContentPage(entry.id))
    .map((entry) => [entry.id.replace(/\.md$/, ""), entry])
);

const slugMap = buildSlugMap(entries);

const summaryPath = fileURLToPath(
  new URL("../../../content/gitbook/SUMMARY.md", import.meta.url)
);

let orderedItems = [];
try {
  const summaryText = readFileSync(summaryPath, "utf-8");
  const summaryItems = parseSummaryItems(summaryText);
  orderedItems = summaryItems
    .filter((item) => item.slug.startsWith(`${category}/`))
    .map((item) => {
      const entry = entryMap.get(item.slug);
      if (!entry || entry.data?.hidden) {
        return null;
      }

      return {
        id: item.slug,
        title: item.title || getTitle(entry),
        href: `/blog/${slugMap.get(entry.id.replace(/\.md$/, ""))}/`,
      };
    })
    .filter(Boolean);
} catch {
  orderedItems = [];
}

if (orderedItems.length === 0) {
  orderedItems = entries
    .filter(
      (entry) =>
        !entry.data?.hidden &&
        isContentPage(entry.id) &&
        entry.id.startsWith(`${category}/`)
    )
    .map((entry) => ({
      id: entry.id.replace(/\.md$/, ""),
      title: getTitle(entry),
      href: `/blog/${slugMap.get(entry.id.replace(/\.md$/, ""))}/`,
    }))
    .sort((a, b) => a.title.localeCompare(b.title));
}

const pageTitle = toLabel(category);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="/styles/home.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="layout">
      <Sidebar />
      <main class="main">
        <h1>{pageTitle}</h1>
        <section>
          <ul>
            {orderedItems.map((item) => (
              <li>
                <a href={item.href}>{item.title}</a>
              </li>
            ))}
          </ul>
        </section>
      </main>
    </div>
    <script>
      const toggle = document.getElementById("sidebar-toggle");
      const body = document.body;
      if (toggle) {
        toggle.addEventListener("click", () => {
          body.classList.toggle("sidebar-collapsed");
        });
      }
    </script>
  </body>
</html>
