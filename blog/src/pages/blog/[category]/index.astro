---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("gitbook");
  const isContentPage = (id) => !/^(README|SUMMARY)\.md$/i.test(id);
  const categories = Array.from(
    new Set(
      entries
        .filter((entry) => !entry.data?.hidden && isContentPage(entry.id))
        .map((entry) => (entry.id.includes("/") ? entry.id.split("/")[0] : null))
        .filter(Boolean)
    )
  );

  return categories.map((slug) => ({
    params: { category: slug },
  }));
}

const { category } = Astro.params;
const target = `/blog/category/${category}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Redirecting...</title>
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>...</p>
  </body>
</html>
