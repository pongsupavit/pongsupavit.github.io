---
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import SidebarLayout from "../layouts/SidebarLayout.astro";

const entries = await getCollection("gitbook");
const summaryPath = fileURLToPath(new URL("../content/gitbook/SUMMARY.md", import.meta.url));

const parseSummaryItems = (text) => {
	const items = [];
	const lines = text.split(/\r?\n/);

	for (const line of lines) {
		const match = line.match(/^\s*\*\s+\[([^\]]+)\]\(([^)\s]+)(?:\s+"([^"]+)")?\)/);
		if (!match) {
			continue;
		}

		const label = match[1].trim();
		const href = match[2].trim();
		const titleAttr = match[3]?.trim();
		const menuLabel = titleAttr || label;
		const isExternal = /^https?:\/\//i.test(href);
		const slug = isExternal ? null : href.replace(/^\.\//, "").replace(/\.md$/i, "");

		items.push({ label, menuLabel, href, titleAttr, isExternal, slug });
	}

	return items;
};

let homeEntry = null;
let homeTitle = "Home";
try {
	const summaryText = readFileSync(summaryPath, "utf-8");
	const summaryItems = parseSummaryItems(summaryText);
		const homeLink =
			summaryItems.find(
				(item) => item.titleAttr && item.titleAttr.toLowerCase() === "home" && !item.isExternal
			) ||
			summaryItems.find(
				(item) =>
					!item.isExternal &&
					(item.label.toLowerCase() === "introduction" ||
						item.titleAttr?.toLowerCase() === "introduction")
			);

	if (homeLink) {
			homeTitle = homeLink.menuLabel || homeLink.label || homeTitle;
		const match = entries.find((entry) => entry.id.replace(/\.md$/, "") === homeLink.slug);
		if (match) {
			homeEntry = match;
		}
	}
} catch {
	homeEntry = null;
}

const homeContent = homeEntry ? await homeEntry.render() : null;
---

<SidebarLayout title="SaaS Midnight">
	<div class="top-actions">
		<button class="icon-btn" aria-label="Globe">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.5 6h-3.4a15 15 0 0 0-1.1-3.2A8.03 8.03 0 0 1 18.5 8zM12 4c.9 1.2 1.6 2.6 2 4H10c.4-1.4 1.1-2.8 2-4zM5.5 8A8.03 8.03 0 0 1 10 4.8 15 15 0 0 0 8.9 8H5.5z"></path>
				<path d="M4 12c0-.7.1-1.4.3-2h3.8c-.1.7-.2 1.3-.2 2s.1 1.3.2 2H4.3c-.2-.6-.3-1.3-.3-2zm11.9 2c.1-.7.2-1.3.2-2s-.1-1.3-.2-2h3.8c.2.6.3 1.3.3 2s-.1 1.4-.3 2z"></path>
				<path d="M5.5 16h3.4c.3 1.1.7 2.2 1.1 3.2A8.03 8.03 0 0 1 5.5 16zm6.5 4c-.9-1.2-1.6-2.6-2-4h4c-.4 1.4-1.1 2.8-2 4zm3.9-4h3.4a8.03 8.03 0 0 1-4.5 3.2c.4-1 .8-2.1 1.1-3.2z"></path>
			</svg>
		</button>
		<button class="icon-btn" aria-label="Theme">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M12 3a9 9 0 1 0 9 9c0-.4 0-.9-.1-1.3a7.2 7.2 0 0 1-2.4.4 7 7 0 0 1-6.9-7 7 7 0 0 1 .4-2.4C12.9 3 12.4 3 12 3z"></path>
			</svg>
		</button>
	</div>
	{homeContent ? (
		<section>
			<h1>{homeTitle}</h1>
			<article>
				<homeContent.Content />
			</article>
		</section>
	) : null}
</SidebarLayout>
