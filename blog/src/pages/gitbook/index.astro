---
import { getCollection } from "astro:content";

const entries = await getCollection("gitbook");
const getTitle = (entry) => {
  if (entry.data?.title) {
    return entry.data.title;
  }

  const match = entry.body?.match(/^#\s+(.+)$/m);
  if (match) {
    return match[1].trim();
  }

  return entry.id;
};

const items = entries
  .map((entry) => ({
    id: entry.id.replace(/\.md$/, ""),
    title: getTitle(entry),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>GitBook</title>
  </head>
  <body>
    <h1>GitBook</h1>
    <ul>
      {items.map((item) => (
        <li>
          <a href={`/gitbook/${item.id}`}>{item.title}</a>
        </li>
      ))}
    </ul>
  </body>
</html>
