---
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import path from "node:path";
import Sidebar from "../components/Sidebar.astro";
import SearchModal from "../components/SearchModal.astro";

const {
  title = "Blog",
  description,
  bodyClass = "",
  extraStyles = [],
  extraFonts = [],
} = Astro.props;

const entries = await getCollection("gitbook");

// Parse config.md for category colors
let categoryColors = {};
try {
  const configPath = path.resolve(process.cwd(), "src/content/gitbook/config/config.md");
  const configText = readFileSync(configPath, "utf-8");
  const tableLines = configText.split("\n").filter(l => l.trim().startsWith("|")).slice(2);
  categoryColors = tableLines.reduce((acc, line) => {
    const cells = line.split("|").map(c => c.trim()).filter(Boolean);
    if (cells.length >= 6) {
      const name = cells[0].replace(/\\/g, "");
      const color = cells[5].replace(/\\/g, "");
      acc[name.toLowerCase()] = color;
    }
    return acc;
  }, {});
} catch (e) {
  console.error("Failed to parse config for search colors", e);
}

// Accurate Slug Mapping logic (shared with Sidebar.astro)
const buildSlugMap = (items) => {
  const counts = new Map();
  const map = new Map();
  for (const entry of items) {
    if (!/^(README|SUMMARY)\.md$/i.test(entry.id)) {
      const base = entry.id.replace(/\.md$/, "").split("/").pop();
      const next = (counts.get(base) || 0) + 1;
      counts.set(base, next);
      const slug = next === 1 ? base : `${base}-${next}`;
      map.set(entry.id.replace(/\.md$/, ""), slug);
    }
  }
  return map;
};
const slugMap = buildSlugMap(entries);

const searchIndex = entries
  .filter(e => !e.data?.hidden && !/^(README|SUMMARY)\.md$/i.test(e.id))
  .map(e => {
    // Improved title extraction
    let displayTitle = e.data?.title;
    if (!displayTitle) {
      const h1Match = e.body?.match(/^#\s+(.+)$/m);
      displayTitle = h1Match ? h1Match[1].trim() : e.id.split("/").pop().replace(/\.md$/, "").replace(/-/g, " ");
    }

    const category = e.id.includes("/") ? e.id.split("/")[0].replace(/-/g, " ") : "Articles";
    const color = categoryColors[category.toLowerCase()] || "default";

    return {
      title: displayTitle,
      href: `/${slugMap.get(e.id.replace(/\.md$/, ""))}/`,
      category,
      color,
      excerpt: e.body?.substring(0, 150).replace(/[#*`]/g, "") + '...',
      body: e.body
    };
  });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    {description ? <meta name="description" content={description} /> : null}
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/theme.css" />
    <link rel="stylesheet" href="/styles/home.css" />
    <link rel="stylesheet" href="/styles/search.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    {extraFonts.map((href) => (
      <link href={href} rel="stylesheet" />
    ))}
    {extraStyles.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div class="layout">
      <Sidebar />
      <main class="main">
        <slot />
      </main>
    </div>
    <SearchModal items={searchIndex} />
  </body>
</html>
