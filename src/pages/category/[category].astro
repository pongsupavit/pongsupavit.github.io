---
import { getCollection } from "astro:content";
import SidebarLayout from "../../layouts/SidebarLayout.astro";
import { getSummaryItems, buildSlugMap } from "../../utils/gitbook";

export async function getStaticPaths() {
  const entries = await getCollection("gitbook");
  const categories = Array.from(
    new Set(
      entries
        .filter((entry) => !entry.data?.hidden && !/^(README|SUMMARY)\.md$/i.test(entry.id))
        .map((entry) => (entry.id.includes("/") ? entry.id.split("/")[0] : null))
        .filter(Boolean)
    )
  );

  return categories.map((slug) => ({
    params: { category: slug },
  }));
}

const entries = await getCollection("gitbook");
const { category } = Astro.params;
const slugMap = buildSlugMap(entries);
const summaryItems = getSummaryItems();

const toLabel = (slug: string) =>
  slug
    .split("-")
    .map((part) => (part ? part[0].toUpperCase() + part.slice(1) : part))
    .join(" ");

const getTitle = (entry: any) => {
  if (entry.data?.title) return entry.data.title;
  const match = entry.body?.match(/^#\s+(.+)$/m);
  if (match) return match[1].trim();
  return entry.id;
};

const entryMap = new Map(
  entries
    .filter((entry) => !/^(README|SUMMARY)\.md$/i.test(entry.id))
    .map((entry) => [entry.id.replace(/\.md$/, ""), entry])
);

let orderedItems = summaryItems
  .filter((item) => !item.isExternal && item.slug?.startsWith(`${category}/`))
  .map((item) => {
    const entry = entryMap.get(item.slug!);
    if (!entry || entry.data?.hidden) return null;

    return {
      id: item.slug,
      title: item.menuLabel || getTitle(entry),
      href: `/${slugMap.get(entry.id.replace(/\.md$/, ""))}/`,
    };
  })
  .filter(Boolean);

if (orderedItems.length === 0) {
  orderedItems = entries
    .filter(
      (entry) =>
        !entry.data?.hidden &&
        !/^(README|SUMMARY)\.md$/i.test(entry.id) &&
        entry.id.startsWith(`${category}/`)
    )
    .map((entry) => ({
      id: entry.id.replace(/\.md$/, ""),
      title: getTitle(entry),
      href: `/${slugMap.get(entry.id.replace(/\.md$/, ""))}/`,
    }))
    .sort((a, b) => a.title.localeCompare(b.title));
}

const pageTitle = toLabel(category!);
---

<SidebarLayout title={pageTitle}>
  <h1>{pageTitle}</h1>
  <section>
    <ul>
      {orderedItems.map((item) => (
        <li>
          <a href={item.href}>{item.title}</a>
        </li>
      ))}
    </ul>
  </section>
</SidebarLayout>
