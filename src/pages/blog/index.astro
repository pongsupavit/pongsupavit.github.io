---
import { getCollection } from "astro:content";
import SidebarLayout from "../../layouts/SidebarLayout.astro";
import { getConfigItems, getSummaryItems, buildSlugMap } from "../../utils/gitbook";

const configItems = getConfigItems();
const summaryItems = getSummaryItems();
const entries = await getCollection("gitbook");
const slugMap = buildSlugMap(entries);

const validBlogCategories = configItems
  .filter(item => item.type === "blog")
  .map(item => item.name.toLowerCase());

const blogEntries = entries.filter((entry) => {
  if (!entry.id.includes("/")) return false;
  const folderName = entry.id.split("/")[0].toLowerCase().replace(/-/g, " "); 
  return validBlogCategories.includes(folderName);
});

const getTitle = (entry: any) => {
  if (entry.data?.title) return entry.data.title;
  const match = entry.body?.match(/^#\s+(.+)$/m);
  if (match) return match[1].trim();
  return entry.id;
};

const summarySections: { title: string | null; items: any[] }[] = [];
let currentSection: { title: string | null; items: any[] } = { title: null, items: [] };

summaryItems.forEach(item => {
  if (item.section !== currentSection.title) {
    if (currentSection.items.length > 0 || currentSection.title) {
      summarySections.push(currentSection);
    }
    currentSection = { title: item.section, items: [] };
  }
  currentSection.items.push(item);
});
summarySections.push(currentSection);

const entryMap = new Map(
  entries
    .filter((entry) => !/^(README|SUMMARY)\.md$/i.test(entry.id))
    .map((entry) => [entry.id.replace(/\.md$/, ""), entry])
);

const sections = summarySections
  .map((section) => {
    const items = section.items
      .map((item) => {
        if (item.isExternal) {
          return {
            id: item.href,
            title: item.menuLabel,
            href: item.href,
            external: true,
          };
        }

        const entry = entryMap.get(item.slug);
        if (!entry || entry.data?.hidden) return null;

        return {
          id: item.slug,
          title: item.menuLabel || getTitle(entry),
          href: `/${slugMap.get(entry.id.replace(/\.md$/, ""))}/`,
          external: false,
        };
      })
      .filter(Boolean);

    return { title: section.title, items };
  })
  .filter((section) => section.items.length > 0);

const fallbackItems = blogEntries
  .map((entry) => ({
    id: slugMap.get(entry.id.replace(/\.md$/, "")),
    title: getTitle(entry),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<SidebarLayout title="Blog">
  <h1>Blog</h1>
  {sections.length > 0 ? (
    sections.map((section) => (
      <section>
        {section.title ? <h2>{section.title}</h2> : null}
        <ul>
          {section.items.map((item) => (
            <li>
              {item.external ? (
                <a href={item.href} target="_blank" rel="noreferrer">
                  {item.title}
                </a>
              ) : (
                <a href={item.href}>{item.title}</a>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  ) : (
    <section>
      <ul>
        {fallbackItems.map((item) => (
          <li>
            <a href={`/${item.id}/`}>{item.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</SidebarLayout>
